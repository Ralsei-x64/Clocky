// Executed by osascript. Query running players without opening an application.
ObjC.import("AppKit");
ObjC.import("ScriptingBridge");
function run() {
    const apps = $.NSWorkspace.sharedWorkspace.runningApplications;
    let paused = null;
    for (let i = 0; i < apps.count; i++) {
        const native = apps.objectAtIndex(i);
        const name = ObjC.unwrap(native.localizedName);
        if (!["Kaset", "Music", "Spotify"].includes(name)) continue;
        try {
            const id = ObjC.unwrap(native.bundleIdentifier);
            const app = Application(id);
            let result;
            if (name === "Kaset") {
                const info = JSON.parse(app.getPlayerInfo());
                const song = info.currentTrack;
                if (!song || !song.name) continue;
                result = {title:song.name, artist:song.artist, position:info.position,
                    duration:info.duration || song.duration, playing:info.isPlaying, art:song.artworkURL};
            } else {
                const state = app.playerState();
                if (state !== "playing" && state !== "paused") continue;
                const track = app.currentTrack;
                result = {title:track.name(), artist:track.artist(), position:app.playerPosition(),
                    duration:track.duration() / (name === "Spotify" ? 1000 : 1), playing:state === "playing"};
                try {
                    if (name === "Spotify") result.art = track.artworkUrl();
                    else {
                        const raw = $.SBApplication.applicationWithBundleIdentifier(id).currentTrack.artworks.firstObject.rawData;
                        if (raw && raw.length < 4*1024*1024) result.art = "data:image/auto;base64," + ObjC.unwrap(raw.base64EncodedStringWithOptions(0));
                    }
                } catch (_) {}
            }
            if (result.playing) return JSON.stringify(result);
            if (!paused) paused = result;
        } catch (_) {}
    }
    return JSON.stringify(paused);
}
